# Optional overrides for deploy/event_mesh/docker-compose.yml
# Copy to .env next to docker-compose.yml (gitignored if desired).

# Host loopback publish ports (debug / verify from the host).
MESH_HOST_PORT_A=8787
MESH_HOST_PORT_B=8788

# Image tag used by both nodes after first build.
KERROS_MESH_IMAGE=kerros-event-mesh:local

# Shared secret for /mesh/ingest and /mesh/publish (ADR-014).
# Change this before any non-lab exposure.
KERROS_EVENT_MESH_TOKEN=kerros-mesh-dev-token
