# Optional overrides for deploy/omniroute/docker-compose.yml
# Copy to .env next to docker-compose.yml (gitignored).

# Pin / bump the published image (default matches README provenance v3.8.49).
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.49

# Host port published on 127.0.0.1 only (container still listens on 20128).
OMNIROUTE_HOST_PORT=20128

# After `scripts/omniroute_droplet.sh up`, point KerrOS at the gateway:
#   export OMNIROUTE_ENDPOINT=http://127.0.0.1:20128/v1
#   export KERROS_USE_OMNIROUTE=1
# Or set config.json: "use_omniroute": true, "omniroute_url": "http://127.0.0.1:20128/v1"
