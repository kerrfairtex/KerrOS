# Optional overrides for deploy/llama_cpp/docker-compose.yml
LLAMA_CPP_IMAGE=ghcr.io/ggerganov/llama.cpp:server
LLAMA_CPP_HOST_PORT=8080
LLAMA_CPP_GGUF=qwen0.5b-q4.gguf
LLAMA_CPP_CTX=4096
# Host models dir (repo models/ by default via compose relative path)
# LLAMA_CPP_MODELS_DIR=/absolute/path/to/models

LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.63.11-stable
LITELLM_HOST_PORT=4000
LITELLM_MASTER_KEY=sk-kerros-dev

# KerrOS client:
# KERROS_OFFLINE_PROFILE=offline_qwen05
# LLAMA_CPP_SERVER_ENDPOINT=http://127.0.0.1:8080/v1
# LITELLM_ENDPOINT=http://127.0.0.1:4000/v1
