# Optional overrides for deploy/qdrant/docker-compose.yml
QDRANT_IMAGE=qdrant/qdrant:v1.13.2
QDRANT_HOST_PORT=6333
QDRANT_HOST_GRPC_PORT=6334

# KerrOS client env (export in shell or .env at repo root):
# KERROS_QDRANT_ENABLED=1
# KERROS_QDRANT_URL=http://127.0.0.1:6333
# KERROS_QDRANT_COLLECTION=kerros_memory
# KERROS_QDRANT_API_KEY=
