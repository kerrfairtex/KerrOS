{
  "model_path": "models/model.gguf",
  "llama_bin": "llama-simple-chat",
  "threads": 4,
  "context_size": 4096,
  "max_tokens": 1024,
  "temperature": 0.7,
  "repeat_penalty": 1.3,
  "memory_limit": 20,
  "summary_trigger": 15,
  "tools_enabled": true,
  "rag_enabled": true,
  "thinking_mode": true,
  "safe_commands": [
    "ls",
    "pwd",
    "date",
    "cat",
    "echo",
    "df",
    "free",
    "uname",
    "ping",
    "traceroute",
    "nmap",
    "curl",
    "wget",
    "ssh",
    "python",
    "python3",
    "git",
    "ip",
    "ifconfig",
    "dig",
    "nslookup",
    "whois",
    "htop",
    "arp",
    "ss",
    "id",
    "whoami",
    "find",
    "grep",
    "ps"
  ],
  "_note": "Secrets (groq_api_key, model paths) are now in .env \u2014 do not add them back here",
  "knowledge_root": "~/storage/external-1/offline_ai_knowledge",
  "knowledge_index": "~/offline_ai/data/knowledge",
  "auto_index": true,
  "repeat_last_n": 256
}