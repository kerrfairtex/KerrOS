# Local LLM ops (C-19) — default off; see deploy/ollama/ and deploy/vllm/
# KERROS_LOCAL_LLM=1
# KERROS_OLLAMA_ENABLED=1
# KERROS_VLLM_ENABLED=1
# KERROS_LLM_PROVIDER=ollama
# OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# VLLM_ENDPOINT=http://127.0.0.1:8000/v1
# VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# ADR-049 soft residuals (never production seals by default):
# KERROS_LOCAL_LLM_PROXY=1
# KERROS_VLLM_MULTINODE=1
# KERROS_MODEL_PULL=1
# KERROS_MODEL_PULL_ALLOW=0
# LOCAL_LLM_PROXY_TOKEN=kerros-dev-token
# ADR-050 offline Qwen 0.5B + llama.cpp (Phase A):
# KERROS_OFFLINE_PROFILE=offline_qwen05
# KERROS_LLM_PROVIDER=llama_cpp
# KERROS_LLAMA_CPP_ENABLED=1
# LLAMA_BIN=~/llama.cpp/build/bin/llama-cli
# MODEL_PATH=~/offline_ai/models/qwen0.5b-q4.gguf
# LLAMA_CPP_SERVER_ENDPOINT=   # optional OpenAI-compat server instead of subprocess
# ./scripts/download_qwen05_gguf.sh
# ADR-051 offline RAG (Phase B) — FTS primary; FAISS soft when profile active:
# KERROS_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# KERROS_EMBEDDING_DIM=768
# KERROS_FAISS_ENABLED=1
# KERROS_FAISS_INDEX_PATH=data/faiss/kerros_memory.npz
# ADR-052 coding index (Phase C):
# KERROS_CODE_INDEX=1
# KERROS_CODE_INDEX_PATH=data/code_index/index.json
# /code-index  /symbols <q>  /code-search <pat>  (rg also in safe_commands)
# Interactive "[code] Found N… Save to file? [y/n]" after AI replies — off by default:
# KERROS_CODE_SAVE_PROMPT=1
# ADR-061 native parallel subagents (default off; RAM-aware, max 2):
# KERROS_SUBAGENTS=1
# KERROS_SUBAGENTS_MAX=2
# /delegate knowledge: <q> || research: <q2>
# ADR-062 agent capability expansion:
# KERROS_TOOL_SEARCH=1
# KERROS_EXEC_GUARD=1
# KERROS_EXEC_APPROVE=1
# KERROS_MCP=1
# KERROS_MCP_LIVE=0
# profile memory add|list :: memory|user :: <text>
# agent cron create :: name :: 0 9 * * * :: <prompt>
# ADR-063 session store / compression / bg processes:
# KERROS_LLM_COMPRESS=1
# KERROS_SESSION_LLM_SUMMARY=1
# list sessions | browse session <id> | bg spawn <cmd>
# ADR-064 skills hub / gateway / bg backends:
# KERROS_SKILLS_HUB_LIVE=0
# KERROS_GATEWAY=1
# KERROS_GATEWAY_PORT=8788
# KERROS_GATEWAY_TOKEN=
# KERROS_BG_BACKEND=local   # local|fake|docker
# KERROS_BG_DOCKER=0
# skills hub install :: path/to/skill.md :: category
# gateway start | gateway inbox
# ADR-053 Unsloth LoRA → GGUF (Phase D) — Fake plan by default:
# KERROS_FINETUNE=1
# KERROS_FINETUNE_BACKEND=fake
# KERROS_FINETUNE_ALLOW_TRAIN=0
# KERROS_FINETUNE_ALLOW_EXPORT=0
# KERROS_FINETUNE_GGUF=~/offline_ai/models/qwen0.5b-q4.gguf
# ./scripts/export_qwen05_lora_gguf.sh plan
# ADR-054 LiteLLM + llama.cpp gateway (Phase E) — Fake plan; Docker optional:
# ./scripts/llama_cpp_docker.sh check
# ./scripts/llama_cpp_docker.sh plan
# ./scripts/llama_cpp_docker.sh up --litellm
# KERROS_LITELLM_ENABLED=1
# KERROS_OFFLINE_GATEWAY=1
# KERROS_LLM_PROVIDER=litellm
# LLAMA_CPP_SERVER_ENDPOINT=http://127.0.0.1:8080/v1
# LITELLM_ENDPOINT=http://127.0.0.1:4000/v1
# LITELLM_MODEL=qwen0.5b-q4
